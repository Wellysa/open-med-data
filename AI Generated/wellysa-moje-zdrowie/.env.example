# Opcjonalnie: adres backendu Twojego panelu admina (bez ukośnika na końcu).
# Bez ustawienia — formularze działają w trybie demo (log w konsoli + localStorage tożsamości).
#
# POST {BASE}/api/landing/survey
#   Content-Type: application/json
#   Body: { "source":"wellysa-landing", "submittedAt":"ISO",
#           "identity":{ "firstName","lastName","pesel","email","phone?" },
#           "survey":{ ... pola ankiety jak w kodzie },
#           "cfTurnstileResponse"?: "<token>" }
#   Backend: zweryfikuj token POST https://challenges.cloudflare.com/turnstile/v0/siteverify
#   (secret po stronie serwera, nigdy w Vite).
#
# POST {BASE}/api/landing/results-upload
#   Content-Type: multipart/form-data
#   Pola: firstName, lastName, pesel, email, notes?, source, submittedAt, cf-turnstile-response?
#   Plik: file (pdf/jpg/png)
#
# Zalecana odpowiedź 200 + JSON (Content-Type: application/json):
#   {
#     "orderId": "...",              # lub "resultsOrderId"
#     "panelCheckoutUrl": "https://...",  # opcjonalnie: pełny URL do płatności / szczegółów zgłoszenia w panelu
#     "interpretationStatus": "pending_payment"  # opcjonalnie: podgląd stanu (patrz GET poniżej)
#   }
#
# Opcjonalnie — do wywołania z panelu / aplikacji (nie wymagane na landing page):
# GET {BASE}/api/landing/results-interpretation/:orderId
#   Zwraca np. {
#     "orderId", "paymentStatus": "pending"|"paid"|...,
#     "interpretationStatus": "pending_payment"|"processing"|"ready"|"awaiting_clinician"|"failed",
#     "interpretation": { "markdown"?, "summary"? },
#     "messageForPatient"?: "..."
#   }
#
VITE_ADMIN_API_BASE_URL=

# Cloudflare Turnstile — klucz witryny (widoczny w bundlu).
# Produkcja: wpisz Site Key z Cloudflare Dashboard → Turnstile.
# npm run dev: przy pustym polu używany jest oficjalny klucz testowy (widget zawsze „pass”).
# Wyłączenie widgetu w dev: VITE_CLOUDFLARE_TURNSTILE_DISABLE_DEV=true
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=

# URL panelu / aplikacji pacjenta (bez końcowego /). Używany do przycisku po wysłaniu PDF.
# Jeśli API zwróci panelCheckoutUrl — ten link ma pierwszeństwo.
VITE_WELLYSA_PANEL_URL=

# Opcjonalnie: względna ścieżka z {orderId}, gdy budujemy link z landingu (gdy brak panelCheckoutUrl z API).
# Domyślnie: /zamowienie/{orderId}
# VITE_WELLYSA_PANEL_ORDER_PATH_TEMPLATE=/zamowienie/{orderId}

# Opcjonalnie: własna etykieta przycisku zamiast „Otwórz panel — płatność i interpretacja”.
# VITE_WELLYSA_PANEL_CTA_LABEL=
